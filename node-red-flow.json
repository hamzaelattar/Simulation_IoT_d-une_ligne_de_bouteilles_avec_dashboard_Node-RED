  {
    "id": "083f29831ad4ce1f",
    "type": "function",
    "z": "52c76f4166d1a2c5",
    "name": "Valider MQTT",
    "func": "let data = msg.payload;\nif (Buffer.isBuffer(data)) data = data.toString('utf8');\nif (typeof data === 'string') {\n  try { data = JSON.parse(data); }\n  catch (error) {\n    node.warn('JSON MQTT invalide : ' + error.message);\n    return null;\n  }\n}\nif (!data || typeof data !== 'object' || Array.isArray(data)) {\n  node.warn('Objet JSON MQTT attendu');\n  return null;\n}\nconst telemetry = { timestamp: new Date().toISOString() };\nconst fields = ['passages', 'conformes', 'rejets', 'emballes', 'tauxDefaut',\n  'produitsParMinute', 'vitesse', 'attenteEmballage', 'attenteControle'];\nfor (const field of fields) {\n  const value = data[field] ?? 0;\n  if (typeof value !== 'number' || !Number.isFinite(value) || value < 0) {\n    node.warn('Champ MQTT invalide : ' + field);\n    return null;\n  }\n  telemetry[field] = value;\n}\ntelemetry.statut = typeof data.statut === 'string' ? data.statut : 'INCONNU';\nreturn { topic: msg.topic || 'ligne/bouteilles/telemetry', payload: telemetry };",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
